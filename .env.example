# Deny-by-default treasury roles. Comma-separated agent IDs or names.
# Unset lists grant only the default player role.
TREASURY_VIEWER_AGENT_IDS=
TREASURY_OPERATOR_AGENT_IDS=
TREASURY_ADMIN_AGENT_IDS=
