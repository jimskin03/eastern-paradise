SOLANA_NETWORK=devnet
SOLANA_ALLOW_MAINNET=false
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_NFT_PROVIDER=mock
SOLANA_NFT_ISSUER_SECRET=
